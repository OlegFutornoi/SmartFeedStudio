# Base URLs for SmartFeed Studio services (Isolated E2E Ports)
E2E_SERVER_API_URL=http://localhost:4001/api
E2E_ADMIN_URL=http://localhost:3001
E2E_LOCAL_DB_URL=http://localhost:5002
E2E_LOCAL_DB_REFERENCE_URL=http://localhost:5001
E2E_DESKTOP_URL=http://127.0.0.1:1421

# Database connection for isolated server-backend teardown (Postgres E2E Container: port 5433)
E2E_TEST_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/smartfeed_test_db?schema=public

# Test Authentication Credentials
E2E_SUPERADMIN_EMAIL=superadmin@smartfeed.local
E2E_SUPERADMIN_PASSWORD=SuperAdminPassword123!
E2E_SUPERADMIN_NAME="E2E Super Admin"
E2E_ADMIN_EMAIL=admin@smartfeed.local
E2E_ADMIN_PASSWORD=adminpassword
E2E_USER_EMAIL=user@smartfeed.local
E2E_USER_PASSWORD=userpassword

# Locale testing
E2E_LOCALE=uk
