# Base URLs for SmartFeed Studio services
E2E_SERVER_API_URL=http://localhost:4000/api
E2E_ADMIN_URL=http://localhost:3000
E2E_LOCAL_DB_URL=http://localhost:5002
E2E_LOCAL_DB_REFERENCE_URL=http://localhost:5001
E2E_DESKTOP_URL=http://127.0.0.1:1421

# Database connection for isolated server-backend teardown (must end with _test)
E2E_TEST_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/smartfeed_test_db?schema=public

# Test Authentication Credentials
E2E_ADMIN_EMAIL=admin@smartfeed.local
E2E_ADMIN_PASSWORD=adminpassword
E2E_USER_EMAIL=user@smartfeed.local
E2E_USER_PASSWORD=userpassword

# Locale testing
E2E_LOCALE=uk
