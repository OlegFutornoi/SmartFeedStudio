# ==============================================================================
# SmartFeed Studio - Global Environment Configuration
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/smartfeed_db?schema=public"

# Redis & BullMQ
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# MinIO / S3 Storage (Cloudflare R2 or MinIO)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadminpassword"
S3_BUCKET_NAME="smartfeed-storage"
S3_FORCE_PATH_STYLE="true"

# JWT Authentication
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production"
JWT_REFRESH_EXPIRATION="7d"

# Backend API Configuration
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000,tauri://localhost,http://localhost:1420"
APP_URL="http://localhost:1420"

# Mail & SMTP Service (Mailpit in dev / SMTP in production)
MAIL_ENABLED="true"
MAIL_HOST="localhost"
MAIL_PORT=1025
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="SmartFeed Studio <no-reply@smartfeed.studio>"

# Admin Portal (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Desktop Client (Tauri / Vite)
VITE_API_URL="http://localhost:4000/api"

