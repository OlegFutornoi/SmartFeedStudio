  sellSpreadPercent Decimal  @default(0) @db.Decimal(5, 2) @map("sell_spread_percent")
  buySpreadPercent  Decimal  @default(0) @db.Decimal(5, 2) @map("buy_spread_percent")
  logoUrl           String?  @map("logo_url")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
