// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum PlanType {
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

enum TargetApp {
  DESKTOP
  ADMIN_PORTAL
  ALL
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  REFUNDED
  EXPIRED
}

enum PaymentProvider {
  WAYFORPAY
  STRIPE
  MANUAL
}

enum PaymentInterval {
  MONTHLY
  YEARLY
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String         @map("password_hash")
  fullName     String?        @map("full_name")
  avatarUrl    String?        @map("avatar_url")
  role         Role           @default(USER)
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  licenses     License[]
  snapshots    Snapshot[]
  storageFiles StorageFile[]
  paymentTransactions PaymentTransaction[]
  suppliers    Supplier[]

  ownedOrganizations      Organization[]           @relation("OrganizationOwner")
  organizationMemberships OrganizationMember[]
  sentInvitations         OrganizationInvitation[] @relation("InvitationSender")

  @@index([role])
  @@index([role, isActive])
  @@index([createdAt])
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("users")
}

model Organization {
  id              String                   @id @default(cuid())
  name            String
  slug            String?                  @unique
  ownerId         String                   @map("owner_id")
  owner           User                     @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         OrganizationMember[]
  invitations     OrganizationInvitation[]
  licenses        License[]
  storageFiles    StorageFile[]
  suppliers       Supplier[]
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerId])
  @@index([createdAt])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MemberRole   @default(MEMBER)
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([joinedAt])
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           MemberRole       @default(MEMBER)
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String           @map("invited_by_id")
  invitedBy      User             @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId])
  @@index([invitedById])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@map("organization_invitations")
}

model TariffPlan {
  id            String    @id @default(cuid())
  code          String    @unique
  nameUk        String    @map("name_uk")
  nameEn        String    @map("name_en")
  descriptionUk String?   @map("description_uk")
  descriptionEn String?   @map("description_en")
  priceMonthly  Decimal   @default(0) @db.Decimal(10, 2) @map("price_monthly")
  priceYearly   Decimal?  @db.Decimal(10, 2) @map("price_yearly")
  currency      String    @default("USD")

  // --- Quota Fields ---
  maxXmlLimit         Int     @default(500)   @map("max_xml_limit") // Max SKU count
  aiCredits           Int     @default(0)     @map("ai_credits") // AI credits per month
  canCloudBackup      Boolean @default(false) @map("can_cloud_backup") // Cloud S3 backup access
  maxFeedsLimit       Int     @default(1)     @map("max_feeds_limit") // Max active feeds
  maxChannelsLimit    Int     @default(1)     @map("max_channels_limit") // Max output channels
  syncFrequencyHours  Int     @default(0)     @map("sync_frequency_hours") // 0=manual, 24=daily, 4=6x/day, 1=hourly
  maxStorageGb        Float   @default(0)     @map("max_storage_gb") // Cloud storage GB (0=disabled)
  maxTeamSeats        Int     @default(1)     @map("max_team_seats") // Team member seats
  maxSuppliersLimit   Int     @default(1)     @map("max_suppliers_limit") // Max connected suppliers

  // --- Feature Flags ---
  hasApiAccess     Boolean  @default(false)  @map("has_api_access") // REST API access
  hasWebhooks      Boolean  @default(false)  @map("has_webhooks") // Webhook push on feed update
  hasFeedDiff      Boolean  @default(false)  @map("has_feed_diff") // Feed version comparison (diff)
  hasWhiteLabel    Boolean  @default(false)  @map("has_white_label") // White-label PDF reports
  hasSso           Boolean  @default(false)  @map("has_sso") // SSO / SAML login
  hasAuditLog      Boolean  @default(false)  @map("has_audit_log") // Full audit trail
  hasCustomS3      Boolean  @default(false)  @map("has_custom_s3") // Custom S3/MinIO endpoint
  hasPriorityAi    Boolean  @default(false)  @map("has_priority_ai") // Priority AI queue
  slaUptimePercent Float?                    @map("sla_uptime_percent") // null=no SLA, 99.9=Enterprise

  // --- Display Fields ---
  isPopular    Boolean   @default(false) @map("is_popular")
  isActive     Boolean   @default(true)  @map("is_active")
  order        Int       @default(0)
  durationDays Int?      @default(7)     @map("duration_days") // Subscription cycle length in days
  featuresUk   String[]  @default([])    @map("features_uk")
  featuresEn   String[]  @default([])    @map("features_en")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt      @map("updated_at") @db.Timestamptz(6)
  licenses     License[]

  @@index([isActive, order])
  @@index([createdAt])
  @@map("tariff_plans")
}

model License {
  id             String      @id @default(cuid())
  userId         String      @map("user_id")
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tariffPlanId   String?     @map("tariff_plan_id")
  tariffPlan     TariffPlan? @relation(fields: [tariffPlanId], references: [id], onDelete: SetNull)
  licenseKey     String      @unique @map("license_key")
  planType       PlanType    @default(STARTER) @map("plan_type")
  canCloudBackup Boolean     @default(false) @map("can_cloud_backup")
  maxXmlLimit    Int         @default(500) @map("max_xml_limit")
  aiCredits      Int         @default(0) @map("ai_credits")
  isActive       Boolean     @default(true) @map("is_active")
  expiresAt      DateTime?   @map("expires_at") @db.Timestamptz(6)

  // Snapshot of quota at time of license creation
  maxFeedsLimit      Int     @default(1) @map("max_feeds_limit")
  maxChannelsLimit   Int     @default(1) @map("max_channels_limit")
  maxTeamSeats       Int     @default(1) @map("max_team_seats")
  maxSuppliersLimit  Int     @default(1) @map("max_suppliers_limit")
  hasApiAccess       Boolean @default(false) @map("has_api_access")
  hasFeedDiff        Boolean @default(false) @map("has_feed_diff")
  hasWhiteLabel      Boolean @default(false) @map("has_white_label")
  hasSso             Boolean @default(false) @map("has_sso")
  hasAuditLog        Boolean @default(false) @map("has_audit_log")
  usedStorageBytes   BigInt  @default(0) @map("used_storage_bytes")
  maxStorageGb       Float   @default(0) @map("max_storage_gb")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizationId String? @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@index([tariffPlanId])
  @@index([organizationId])
  @@index([isActive])
  @@index([createdAt])
  @@index([licenseKey(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("licenses")
}

model Snapshot {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshotName String   @map("snapshot_name")
  s3Key        String   @map("s3_key")
  sizeBytes    BigInt   @map("size_bytes")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([createdAt])
  @@map("snapshots")
}

model NavigationItem {
  id            String    @id @default(cuid())
  key           String    @unique
  labelUk       String    @map("label_uk")
  labelEn       String    @map("label_en")
  path          String
  icon          String    @default("LayoutDashboard")
  order         Int       @default(0)
  isVisible     Boolean   @default(true) @map("is_visible")
  requiredRoles Role[]    @default([USER, ADMIN, SUPER_ADMIN]) @map("required_roles")
  requiredPlan  PlanType? @map("required_plan")
  targetApp     TargetApp @default(DESKTOP) @map("target_app")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([targetApp, isVisible, order])
  @@map("navigation_items")
}

model PageGuide {
  id            String    @id @default(cuid())
  route         String    @unique
  titleUk       String    @map("title_uk")
  titleEn       String    @map("title_en")
  icon          String    @default("HelpCircle")
  badgeUk       String    @default("AI Асистент") @map("badge_uk")
  badgeEn       String    @default("AI Assistant") @map("badge_en")
  summaryUk     String    @map("summary_uk")
  summaryEn     String    @map("summary_en")
  descriptionUk String    @map("description_uk")
  descriptionEn String    @map("description_en")
  featuresUk    String[]  @default([]) @map("features_uk")
  featuresEn    String[]  @default([]) @map("features_en")
  proTipUk      String?   @map("pro_tip_uk")
  proTipEn      String?   @map("pro_tip_en")
  order         Int       @default(0)
  targetApp     TargetApp @default(DESKTOP) @map("target_app")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([targetApp, order])
  @@map("page_guides")
}

model AiAssistantSetting {
  id        String   @id @default(cuid())
  name      String   @default("SmartFeed AI Copilot")
  avatarUrl String?  @map("avatar_url")
  roleUk    String   @default("Персональний AI-асистент з товарних каталогів та фідів") @map("role_uk")
  roleEn    String   @default("Personal AI Catalog & Feed Copilot") @map("role_en")
  badgeUk   String   @default("AI Автопілот 24/7") @map("badge_uk")
  badgeEn   String   @default("24/7 AI Autopilot") @map("badge_en")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("ai_assistant_settings")
}

model PaymentTransaction {
  id                String          @id @default(cuid())
  orderReference    String          @unique @map("order_reference")
  userId            String          @map("user_id")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode          String          @map("plan_code")
  billingInterval   PaymentInterval @default(MONTHLY) @map("billing_interval")
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("UAH")
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider @default(WAYFORPAY)
  providerPaymentId String?         @map("provider_payment_id")
  cardPan           String?         @map("card_pan")
  cardType          String?         @map("card_type")
  issuerBank        String?         @map("issuer_bank")
  failureReason     String?         @map("failure_reason")
  paymentMethod     String?         @map("payment_method")
  signature         String?
  metadata          Json?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([createdAt])
  @@map("payment_transactions")
}

model PaymentSetting {
  id                 String          @id @default(cuid())
  provider           PaymentProvider @unique
  isEnabled          Boolean         @default(true) @map("is_enabled")
  isTestMode         Boolean         @default(true) @map("is_test_mode")
  merchantAccount    String?         @map("merchant_account")
  merchantSecretKey  String?         @map("merchant_secret_key")
  merchantDomain     String?         @map("merchant_domain")
  serviceUrl         String?         @map("service_url")
  returnUrl          String?         @map("return_url")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("payment_settings")
}

model LegalDocument {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleUk     String   @map("title_uk")
  titleEn     String   @map("title_en")
  contentUk   String   @map("content_uk") @db.Text
  contentEn   String   @map("content_en") @db.Text
  isPublished Boolean  @default(true) @map("is_published")
  version     String   @default("2.0")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([slug, isPublished])
  @@index([createdAt])
  @@map("legal_documents")
}

enum StorageFileCategory {
  PRODUCT_IMAGE
  FEED_CATALOG
  SYSTEM_BACKUP
  EXPORT_ARCHIVE
}

enum StorageFileStatus {
  PENDING_UPLOAD
  ACTIVE
  DELETED
}

model StorageFile {
  id              String               @id @default(cuid())
  userId          String               @map("user_id")
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String?              @map("organization_id")
  organization    Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  category        StorageFileCategory  @map("category")
  status          StorageFileStatus    @default(PENDING_UPLOAD) @map("status")
  
  bucketName      String               @map("bucket_name")
  s3Key           String               @unique @map("s3_key")
  publicUrl       String               @map("public_url")
  
  originalName    String               @map("original_name")
  mimeType        String               @map("mime_type")
  sizeBytes       BigInt               @default(0) @map("size_bytes")
  checksumSha256  String?              @map("checksum_sha256")
  width           Int?                 @map("width")
  height          Int?                 @map("height")
  
  refCount        Int                  @default(1) @map("ref_count")
  expiresAt       DateTime?            @map("expires_at") @db.Timestamptz(6)
  
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?            @map("deleted_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([userId, status])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([category, status])
  @@index([checksumSha256])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@map("storage_files")
}

model Supplier {
  id                    String                 @id @default(cuid())
  organizationId        String?                @map("organization_id")
  organization          Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                String                 @map("user_id")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  code                  String
  contactPhone          String?                @map("contact_phone")
  contactEmail          String?                @map("contact_email")
  website               String?
  notes                 String?
  logoUrl               String?                @map("logo_url")
  legalName             String?                @map("legal_name")
  taxId                 String?                @map("tax_id")
  industry              String?
  segment               String?
  managerName           String?                @map("manager_name")
  managerPosition       String?                @map("manager_position")
  managerPhone          String?                @map("manager_phone")
  managerEmail          String?                @map("manager_email")
  managerTelegram       String?                @map("manager_telegram")
  country               String?
  city                  String?
  address               String?
  postcode              String?
  baseCurrency          String                 @default("UAH") @map("base_currency")
  targetCurrency        String                 @default("UAH") @map("target_currency")
  exchangeRateMode      String                 @default("MANUAL") @map("exchange_rate_mode")
  exchangeRate          Decimal                @default(1.0) @db.Decimal(10, 4) @map("exchange_rate")
  currencyBufferPercent Decimal                @default(0) @db.Decimal(5, 2) @map("currency_buffer_percent")
  priceRounding         String                 @default("NONE") @map("price_rounding")
  defaultMarginPercent  Decimal                @default(0) @db.Decimal(5, 2) @map("default_margin_percent")
  defaultFixedMarkup    Decimal                @default(0) @db.Decimal(10, 2) @map("default_fixed_markup")
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  categoryRules         SupplierCategoryRule[]
  pricingRules          SupplierPricingRule[]
  syncSettings          SupplierSyncSetting?
  syncLogs              SupplierSyncLog[]

  @@unique([userId, code])
  @@index([organizationId])
  @@index([userId])
  @@index([isActive])
  @@index([createdAt])
  @@map("suppliers")
}

model SupplierCategoryRule {
  id             String    @id @default(cuid())
  supplierId     String    @map("supplier_id")
  supplier       Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  feedCategoryId String    @map("feed_category_id")
  name           String
  parentId       String?   @map("parent_id")
  isActive       Boolean   @default(true) @map("is_active")
  marginPercent  Decimal?  @db.Decimal(5, 2) @map("margin_percent")
  fixedMarkup    Decimal?  @db.Decimal(10, 2) @map("fixed_markup")
  productCount   Int       @default(0) @map("product_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([supplierId, feedCategoryId])
  @@index([supplierId])
  @@index([supplierId, isActive])
  @@map("supplier_category_rules")
}

model SupplierPricingRule {
  id             String    @id @default(cuid())
  supplierId     String    @map("supplier_id")
  supplier       Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoryId     String?   @map("category_id")
  categoryNameUk String?   @map("category_name_uk")
  categoryNameEn String?   @map("category_name_en")
  minPrice       Decimal?  @db.Decimal(10, 2) @map("min_price")
  maxPrice       Decimal?  @db.Decimal(10, 2) @map("max_price")
  marginPercent  Decimal   @default(0) @db.Decimal(5, 2) @map("margin_percent")
  fixedMarkup    Decimal   @default(0) @db.Decimal(10, 2) @map("fixed_markup")
  priority       Int       @default(0)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([supplierId])
  @@index([supplierId, isActive, priority])
  @@map("supplier_pricing_rules")
}

model SupplierSyncSetting {
  id                    String    @id @default(cuid())
  supplierId            String    @unique @map("supplier_id")
  supplier              Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  protectEditedProducts Boolean   @default(true) @map("protect_edited_products")
  syncPrices            Boolean   @default(true) @map("sync_prices")
  syncStocks            Boolean   @default(true) @map("sync_stocks")
  imageSyncMode         String    @default("DO_NOT_UPDATE") @map("image_sync_mode")
  descriptionSyncMode   String    @default("DO_NOT_UPDATE") @map("description_sync_mode")
  attributesSyncMode    String    @default("ADD_NEW_ONLY") @map("attributes_sync_mode")
  titleSyncMode         String    @default("DO_NOT_UPDATE") @map("title_sync_mode")
  categorySyncMode      String    @default("KEEP_MANUAL_MAPPING") @map("category_sync_mode")
  barcodeSyncMode       String    @default("FILL_EMPTY_ONLY") @map("barcode_sync_mode")
  priceSource           String    @default("WHOLESALE") @map("price_source")
  zeroPriceAction       String    @default("OUT_OF_STOCK") @map("zero_price_action")
  missingProductsAction String    @default("OUT_OF_STOCK") @map("missing_products_action")
  newProductsAction     String    @default("AUTO_PUBLISH") @map("new_products_action")
  syncIntervalHours     Int       @default(0) @map("sync_interval_hours")
  lastSyncedAt          DateTime? @map("last_synced_at") @db.Timestamptz(6)
  lastSyncStatus        String    @default("IDLE") @map("last_sync_status")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([supplierId])
  @@map("supplier_sync_settings")
}

model SupplierSyncLog {
  id              String    @id @default(cuid())
  supplierId      String    @map("supplier_id")
  supplier        Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  feedSourceId    String?   @map("feed_source_id")
  trigger         String    @default("MANUAL")
  status          String    @default("RUNNING")
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  durationMs      Int?      @map("duration_ms")
  totalProducts   Int       @default(0) @map("total_products")
  createdCount    Int       @default(0) @map("created_count")
  updatedCount    Int       @default(0) @map("updated_count")
  outOfStockCount Int       @default(0) @map("out_of_stock_count")
  errorsCount     Int       @default(0) @map("errors_count")
  errorMessage    String?   @map("error_message")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([supplierId])
  @@index([supplierId, createdAt])
  @@map("supplier_sync_logs")
}

model BankCurrencyProvider {
  id                String   @id @default(cuid())
  bankId            String   @unique @map("bank_id")
  bankName          String   @map("bank_name")
  badge             String   @map("badge")
  isEnabled         Boolean  @default(true) @map("is_enabled")
