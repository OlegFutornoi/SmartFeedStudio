{
  "name": "@smartfeed/backend-api",
  "version": "1.0.0",
  "private": true,
  "description": "SmartFeed Studio Backend API with NestJS, CQRS, Prisma, BullMQ, and MinIO/S3",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "admin:set": "ts-node prisma/set-admin.ts",
    "test": "jest",
    "test:e2e": "DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/smartfeed_test_db?schema=public prisma db push && DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/smartfeed_test_db?schema=public ts-node prisma/seed.ts && DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/smartfeed_test_db?schema=public jest --config ./test/jest-e2e.json --runInBand --forceExit",
    "postinstall": "prisma generate || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.734.0",
    "@aws-sdk/s3-request-presigner": "^3.734.0",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.10.0",
    "@smartfeed/shared": "workspace:*",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "express": "^5.0.0",
    "fast-xml-parser": "^5.11.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
