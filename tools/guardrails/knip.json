{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "tools/**/*.mjs"],
      "project": ["scripts/**/*.mjs", "tools/**/*.mjs"]
    },
    "packages/shared": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "services/backend-api": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["src/generated/**"]
    },
    "apps/desktop": {
      "entry": ["src/main.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/admin-portal": {
      "entry": ["src/app/**/{page,layout,route}.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "e2e": {
      "entry": ["playwright.config.ts", "**/*.spec.ts", "**/*.setup.ts", "**/*.teardown.ts"],
      "project": ["**/*.ts"]
    }
  }
}
