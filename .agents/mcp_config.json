{
  "mcpServers": {
    "api-anything": {
      "args": ["/Users/oleg/.local/api-anything/dist/cli.js", "mcp", "--allow-writes"],
      "command": "/usr/local/bin/node"
    },
    "context7": {
      "args": [
        "-c",
        "CONTEXT7_API_KEY=${CONTEXT7_API_KEY:-$(security find-generic-password -a oleg -s CONTEXT7_API_KEY -w 2>/dev/null)} exec npx -y @upstash/context7-mcp"
      ],
      "command": "/bin/bash"
    },
    "firecrawl": {
      "args": [
        "-c",
        "FIRECRAWL_API_KEY=${FIRECRAWL_API_KEY:-$(security find-generic-password -a oleg -s FIRECRAWL_API_KEY -w 2>/dev/null)} exec npx -y firecrawl-mcp"
      ],
      "command": "/bin/bash"
    },
    "github": {
      "args": [
        "-c",
        "GITHUB_PERSONAL_ACCESS_TOKEN=$(/opt/homebrew/bin/gh auth token 2>/dev/null) exec /opt/homebrew/bin/github-mcp-server stdio --read-only"
      ],
      "command": "/bin/bash"
    },
    "playwright": {
      "args": ["-y", "@playwright/mcp@latest"],
      "command": "npx"
    },
    "postgres": {
      "args": [
        "-c",
        "DB_CONN=${DATABASE_URL:-postgresql://postgres@127.0.0.1:5432/smartfeed_db}; exec /Users/oleg/.local/bin/postgres-mcp --access-mode=restricted \"$DB_CONN\""
      ],
      "command": "/bin/bash",
      "disabled": false
    },
    "railway": {
      "args": [
        "-c",
        "RAILWAY_TOKEN=${RAILWAY_TOKEN:-$(security find-generic-password -a oleg -s RAILWAY_TOKEN -w 2>/dev/null)} exec /Users/oleg/.railway/bin/railway mcp"
      ],
      "command": "/bin/bash"
    },
    "redis": {
      "args": [
        "--with",
        "mcp<2",
        "--from",
        "redis-mcp-server",
        "redis-mcp-server",
        "--url",
        "redis://127.0.0.1:6379"
      ],
      "command": "/opt/homebrew/bin/uvx"
    },
    "sentry": {
      "command": "/Library/Frameworks/Python.framework/Versions/3.13/bin/mcp-server-sentry"
    },
    "shadcn": {
      "args": ["-y", "shadcn@latest", "mcp"],
      "command": "npx"
    },
    "headroom": {
      "command": "/Users/oleg/.local/bin/headroom",
      "args": ["mcp", "serve"]
    }
  }
}
