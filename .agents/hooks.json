{
  "auto-formatter": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/auto-format.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
