{
  "workspace-safety-guard": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/session-start.mjs",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|read_file|view_file|call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/pre-tool-guard.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/auto-format.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/stop-guard.mjs",
        "timeout": 10
      }
    ]
  }
}
