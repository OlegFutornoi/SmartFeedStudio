{
  "name": "smartfeed-studio-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SmartFeed Studio Monorepo - Tauri v2, Next.js Admin Portal, NestJS CQRS API, and Shared Packages",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:backend": "pnpm --filter @smartfeed/backend-api dev",
    "dev:admin": "pnpm --filter @smartfeed/admin-portal dev",
    "dev:desktop": "pnpm --filter @smartfeed/desktop dev",
    "build": "turbo run build",
    "build:shared": "pnpm --filter @smartfeed/shared build",
    "build:backend": "pnpm --filter @smartfeed/backend-api build",
    "build:admin": "pnpm --filter @smartfeed/admin-portal build",
    "build:desktop": "pnpm --filter @smartfeed/desktop build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "test": "turbo run test",
    "prepare": "husky",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "prisma:generate": "pnpm --filter @smartfeed/backend-api prisma:generate",
    "prisma:migrate": "pnpm --filter @smartfeed/backend-api prisma:migrate",
    "prisma:studio": "pnpm --filter @smartfeed/backend-api prisma:studio",
    "prisma:seed": "pnpm --filter @smartfeed/backend-api prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
