{
  "name": "smartfeed-studio-monorepo",
  "version": "1.0.1",
  "private": true,
  "description": "SmartFeed Studio Monorepo - Tauri v2, Next.js Admin Portal, NestJS CQRS API, and Shared Packages",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "predev": "node scripts/free-dev-ports.mjs",
    "dev": "turbo run dev --parallel",
    "dev:all": "node scripts/free-dev-ports.mjs && node .agents/scripts/start-dev.mjs",
    "ports:free": "node scripts/free-dev-ports.mjs",
    "start": "pnpm --filter @smartfeed/backend-api start:prod",
    "start:dev": "node scripts/free-dev-ports.mjs && node .agents/scripts/start-dev.mjs",
    "predev:backend": "node scripts/free-dev-ports.mjs 4000",
    "dev:backend": "pnpm --filter @smartfeed/backend-api dev",
    "predev:admin": "node scripts/free-dev-ports.mjs 3000",
    "dev:admin": "pnpm --filter @smartfeed/admin-portal dev",
    "predev:desktop": "node scripts/free-dev-ports.mjs 1420",
    "dev:desktop": "pnpm --filter @smartfeed/desktop dev",
    "predev:desktop:e2e": "node scripts/free-dev-ports.mjs 1421",
    "dev:desktop:e2e": "pnpm --filter @smartfeed/desktop dev:e2e",
    "predev:docs": "node scripts/free-dev-ports.mjs 4321",
    "dev:docs": "pnpm --filter @smartfeed/docs dev",
    "build": "turbo run build",
    "build:shared": "pnpm --filter @smartfeed/shared build",
    "build:backend": "pnpm --filter @smartfeed/backend-api build",
    "build:admin": "pnpm --filter @smartfeed/admin-portal build",
    "build:desktop": "pnpm --filter @smartfeed/desktop build",
    "build:docs": "pnpm --filter @smartfeed/docs build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "e2e": "pnpm --filter @smartfeed/e2e test",
    "e2e:server": "pnpm --filter @smartfeed/e2e test:server",
    "e2e:server:backend": "pnpm --filter @smartfeed/e2e test:server:backend",
    "e2e:server:admin": "pnpm --filter @smartfeed/e2e test:server:admin",
    "e2e:local": "pnpm --filter @smartfeed/e2e test:local",
    "e2e:local:backend": "pnpm --filter @smartfeed/e2e test:local:backend",
    "e2e:local:desktop": "pnpm --filter @smartfeed/e2e test:local:desktop",
    "e2e:ui": "pnpm --filter @smartfeed/e2e test:ui",
    "e2e:report": "pnpm --filter @smartfeed/e2e report",
    "db:local:sync": "docker compose up -d --build sqlite-dev sqlite-dev-e2e",
    "db:local:check": "node scripts/check-local-db-parity.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "invariants:check": "node tools/guardrails/collect.mjs",
    "guardrails:check": "node tools/guardrails/collect.mjs",
    "guardrails:baseline": "node tools/guardrails/collect.mjs --update",
    "guardrails:test": "node --test tools/guardrails/*.test.mjs",
    "depcruise": "depcruise apps services packages --config tools/guardrails/dependency-cruiser.cjs --ignore-known tools/guardrails/dependency-cruiser-known-violations.json",
    "depcruise:baseline": "depcruise apps services packages --config tools/guardrails/dependency-cruiser.cjs --baseline tools/guardrails/dependency-cruiser-known-violations.json",
    "knip": "knip -c tools/guardrails/knip.json --no-config-hints --max-issues 250",
    "knip:ci": "knip -c tools/guardrails/knip.json --no-config-hints --max-issues 250",
    "agents:check": "python3 .agents/scripts/validate_agents.py",
    "deps:check": "pnpm outdated || true",
    "deps:update": "pnpm update -r",
    "version:sync": "node scripts/sync-desktop-version.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "verify:rust": "node scripts/verify-rust.mjs",
    "verify:fast": "pnpm build:shared && pnpm lint && pnpm i18n:check && pnpm invariants:check && pnpm depcruise && pnpm agents:check && pnpm --filter @smartfeed/backend-api exec tsc --noEmit && pnpm --filter @smartfeed/desktop exec tsc --noEmit && pnpm --filter @smartfeed/admin-portal exec tsc --noEmit && pnpm --filter @smartfeed/shared exec tsc --noEmit && pnpm --filter @smartfeed/e2e exec tsc --noEmit && node scripts/verify-rust.mjs",
    "verify:build": "pnpm verify:fast && pnpm build:shared && pnpm prisma:generate && pnpm build:backend && pnpm build:desktop && node scripts/verify-rust.mjs --strict",
    "verify:docker": "docker build -t smartfeed-backend-test -f services/backend-api/Dockerfile .",
    "verify:all": "pnpm verify:build && pnpm verify:docker",
    "prepare": "husky || true",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "mail:open": "open http://localhost:8025 || xdg-open http://localhost:8025",
    "mail:logs": "docker compose logs -f mailpit",
    "prisma:generate": "pnpm --filter @smartfeed/backend-api prisma:generate",
    "prisma:migrate": "pnpm --filter @smartfeed/backend-api prisma:migrate",
    "prisma:studio": "pnpm --filter @smartfeed/backend-api prisma:studio",
    "prisma:seed": "pnpm --filter @smartfeed/backend-api prisma:seed",
    "admin:set": "pnpm --filter @smartfeed/backend-api admin:set",
    "sentry:issues": "node scripts/sentry.mjs list",
    "sentry:issue": "node scripts/sentry.mjs issue"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "shadcn": "^4.21.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "dependencies": {
    "@sentry/nextjs": "^10"
  }
}
