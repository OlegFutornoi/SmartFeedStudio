# ==============================================================================
# SmartFeed Studio — Production Environment Configuration (.env.production)
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_DB=smartfeed_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_secure_database_password_here
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:generate_a_secure_database_password_here@postgres:5432/smartfeed_db?schema=public"

# Redis & BullMQ
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=""

# S3 / Object Storage (MinIO or Cloudflare R2 / AWS S3)
S3_ENDPOINT="http://minio:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="generate_a_secure_minio_password_here"
S3_BUCKET_NAME="smartfeed-storage"
S3_FORCE_PATH_STYLE="true"
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# JWT Authentication (generate 64+ char random keys for production)
JWT_ACCESS_SECRET="generate_a_minimum_64_character_random_string_for_access_secret"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="generate_a_minimum_64_character_random_string_for_refresh_secret"
JWT_REFRESH_EXPIRATION="7d"

# Backend API Configuration
PORT=4000
NODE_ENV="production"
CORS_ORIGIN="https://admin.yourdomain.com,tauri://localhost,http://localhost:1420"
APP_URL="https://admin.yourdomain.com"
PRISMA_DB_PUSH="true"

# Mail & SMTP Service (SMTP provider like Sendgrid, Resend, Postmark or Mailpit)
MAIL_ENABLED="true"
MAIL_HOST="mailpit"
MAIL_PORT=1025
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="SmartFeed Studio <no-reply@smartfeed.studio>"
MAIL_SMTP_PORT=1025
MAIL_WEB_PORT=8025

# Admin Portal (Next.js 14)
ADMIN_PORT=3000
NEXT_PUBLIC_API_URL="https://api.yourdomain.com/api"
